# sales-insight 运行时配置 —— **形状说明,不含任何真实值**
#
# 复制成 sales-insight.env 后填入真实值再部署：
#
#   cp deploy/sales-insight.env.example deploy/sales-insight.env
#   # 编辑填值
#   deployer\deploy-supertrade.ps1 -Step env -Service @('sales-insight')
#
# deploy/*.env 已进 .gitignore，**绝不要**把真实值加回来。
# 本文件是唯一进版本库的东西 —— 它的作用是让人知道要配哪些键、
# 每个键不配会怎样，而不是提供默认值。

# ---- 天气（可选：不配则日报照出，天气显式降级）----
#
# ⚠️ BASE_URL 与 KEY 必须成对来自和风控制台的**同一个订阅**。
#   和风按订阅套餐分配 host：生产那个 key 在 devapi / api / geoapi
#   上一律 403 invalid-host —— 那不是 key 错，是这些 host 不在订阅里。
#   形如 xxxxx.re.qweatherapi.com 的专属 host 才是对的。
#
#   KEY 不配 → 天气不可用，卡片里明说原因。
#   BASE_URL 不配 → 回落到 devapi（对生产 key 不可用）。
#   两者都不配 → 日报其余部分（数字/排行/缺货归因/供应商）完全不受影响。
WEATHER_QWEATHER_BASE_URL=
WEATHER_QWEATHER_KEY=

# ---- 天气调用配额 ----
#
# 和风按"每天 00:00 归零"计配额，上限 1500 次/天。
# 一次报告 = 2 次请求（实况 + 分钟级降水）。
#
# ⚠️ 计数**落盘**，因为 systemd 重启（发版/崩溃）会让内存计数归零，
#   而日报是 dapr job 每天触发的 —— 那会让额度被反复重置。
#
#   不配        → 用 1500（和风官方上限）
#   配小一点    → 提前留缓冲（比如 1200），余量用于人工调试
#   配 0 或负数 → 回落默认值 1500（**不是**"不限制"，不要靠它关保护）
#
# 超限后：当天不再发请求，天气显式降级（available=false + 原因），
# 报告其余部分照出。
WEATHER_QWEATHER_DAILY_LIMIT=

# 计数文件路径。留空 = 落在用户缓存目录。
# ⚠️ 生产建议显式指到**会被备份**的目录，否则重装系统要重新"攒"配额。
WEATHER_QUOTA_FILE=

# ---- 供应商忽略名单 ----
#
# 一份按门店拆分的 JSON 文件，决定哪些供应商（通常是门店自营采购单元）
# 不出现在 AI 销售报告的「供应商排行」里。
#
# ⚠️ 必须落盘：名单放内存的话重启后名单空掉 → 自用供应商全部涌回榜单，
#   而报告里**没有任何异常信号**（这正是 store 里 Configured 标志的用途）。
#
# ⚠️ 建议指向**会被备份**的目录 —— 否则重装系统后每家门店都要重新配一遍。
SUPPLIER_IGNORE_DIR=

# ---- 门店位置（天气必需）----
#
# ⚠️ **不要填 0/0** —— 那会命中几内亚湾，天气 API 会正常返回那里的天气，
#   报告里写"晴 26℃"且没有任何异常信号。宁可留空显式降级。
#   填了之后天气查询精度按坐标走；坐标是**业务配置**，换门店改这里即可。
STORE_CITY=
STORE_LAT=
STORE_LON=

# ---- 自用供应商关键词覆盖（可选）----
#
# 三层识别里第 3 层必须外置可配：每家门店的自用命名不同
# （"自购""自营""自产""内部周转"…），硬编码等于换一家门店就漏排。
# 留空 = 用代码内置默认表。要禁用请用 SELFUSE_KEYWORDS_DISABLED=1，
# **不要**靠"配成空串"来关 —— 那是一个更危险的语义。
SELFUSE_KEYWORDS=
