# cash-recon 运行时配置 —— **形状说明,不含任何真实值**
#
# 复制成 cash-recon.env 后填入真实值再部署：
#
#   cp deploy/cash-recon.env.example deploy/cash-recon.env
#   # 编辑填值
#   deployer\deploy-supertrade.ps1 -Step env -Service @('cash-recon')
#
# deploy/*.env 已进 .gitignore,**绝不要**把真实值加回来。
# 本文件的作用是让人知道要配哪些键、每个键不配会怎样。
#
# ⚠️ 服务账号凭据**不在这里**:它由 systemd unit 的
#   EnvironmentFile=/opt/YunBright/.dapr/supertrade-auth-service-account.env
#   提供(authkit/userinfo 用自己的账号换机器 token 打 userd 的 /internal/users/*)。

# ---- 数据库(必填)----
#
# 本服务**拥有** recon_* 共 17 张表 + 只读 settlement-auditor 的企微月度总表。
# 不配 → 启动即失败(initApp 返回错误,进程退出),不会带着半初始化状态提供服务。
# ⚠️ 与 unit 里的 POSTGRES_DSN 必须一致;两处不一致的症状是
#   "表建在了另一个库里,业务读不到自己的数据"。
POSTGRES_DSN=

# ---- 业务日时区 ----
#
# 决定"某笔流水属于哪一天"。收银/银行流水的时间戳都是**带时区的时间**,
# 按这个时区折算成业务日再聚合。
#
#   不配 → 默认 Asia/Shanghai
#   配错 → 跨零点后的流水会落到前一天(差异工作台每天多出伪时滞差异)
CASH_RECON_BIZ_TZ=

# ---- cube 查询超时 ----
#
# 单次 cube 查询的硬超时。超时后 fail-fast 返回 503,**不回落本地 PG** ——
# 回落会让"今天的数据"和"昨天的数据"来自两个源,差异无法解释。
#
# 口径:取值如 30s / 20s(Go duration 格式)。
#   不配 → 默认 30s
#   配太大 → 慢查询会把 dapr sidecar 连接占满,连带其它端点一起变慢
CUBE_TIMEOUT=

# ---- 单次对账日期区间上限(天)----
#
# preview/apply 允许的最大跨天数。cube 按**逐业务日 × pay_way 聚合**查询,
# 区间越大查询次数线性增长 ⇒ 上限必须存在。
#
#   不配 → 默认 31
#   配太大 → 一次 month-end 重算可能打满 cube,且这是**生产**数据源
MAX_RANGE_DAYS=

# ---- cube 聚合结果缓存 TTL ----
#
# 同一(门店, 业务日)的聚合结果在进程内缓存多久。审核计算(freeze)会**绕过**
# 缓存重新查(冻结必须是当下事实)。
#
#   不配 → 默认 5m
#   配 0  → 关闭缓存(每次 preview 都打 cube,不推荐)
CACHE_TTL=

# ---- 收款凭证附件上限 ----
#
# 一期附件存 PG bytea(FR-05 其他收款凭证)。
#
#   不配 → 默认 5242880(5MB,单个文件)
#   配太大 → 单行 bytea 过大会拖慢 PG 的 autovacuum 与备份/恢复
ATTACHMENT_MAX_BYTES=

# ---- 默认匹配容差(天)----
#
# 收银流水与银行流水的到账时滞窗口。笔数口径的"容差"由规则表
# (recon_rules)按门店覆盖,这里是全局兜底值。
#
#   不配 → 默认 1
#   配太大 → 时滞差异被吞进匹配,真实的"未到账"不再被提示
DEFAULT_TOLERANCE_DAYS=

# ---- 现金长短款容差(元)----
#
# 现金实盘与应收现金的差额在此以内视为"平",超出才进长短款台账。
#
#   不配 → 默认 5
#   配 0  → 每一分钱差异都进台账(噪音大,但不会漏)
DEFAULT_CASH_TOLERANCE_YUAN=

# ---- dapr 端口(必须与 unit 一致)----
#
# unit 里 `dapr run --dapr-http-port 3121 --dapr-grpc-port 6121`。
# 这两个 env 供**服务进程内**通过 sidecar 调用 userd 时使用;
# 与 unit 不一致的症状是"启动成功、所有鉴权查询 503"。
DAPR_HTTP_PORT=3121
DAPR_GRPC_PORT=6121
